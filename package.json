{
  "name": "quran-academy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev -H 127.0.0.1 -p 3000",
    "dev:turbo": "next dev --turbopack",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "next build",
    "start": "next start",
    "start:host": "next start -H 127.0.0.1 -p 3000",
    "start:3001": "next start -p 3001",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "quran:build-meta": "node scripts/build-quran-verse-meta.mjs",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env -- npx tsx prisma/seed.ts",
    "db:prepare": "node scripts/ensure-database.cjs && npm run db:push && npm run db:seed",
    "postinstall": "prisma generate",
    "backup": "dotenv -e .env -- npx tsx scripts/backup-daily.ts",
    "splash:generate": "node scripts/generate-apple-splash.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.9",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.5",
    "quran-json": "^3.1.2"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.16",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.9",
    "pg": "^8.13.1",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "glob": "^11.0.0",
    "source-map": "0.7.4",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@1.5.0",
    "postcss": "^8.5.10",
    "serialize-javascript": "^7.0.5"
  }
}
