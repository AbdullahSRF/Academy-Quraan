generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  PARENT
}

enum StudentStatus {
  REGULAR
  PAUSED
  FROZEN
  WITHDRAWN
  /** أرشفة — يبقى السجل للتاريخ دون اعتباره نشطًا في القوائم اليومية */
  ARCHIVED
}

enum Weekday {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

enum MemorizationType {
  NEW_MEMORIZATION
  REVIEW
  RECITATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

/** مناطق الحفظ الثلاث — راجع docs/MEMORIZATION_SYSTEM.md */
enum MemorizationZoneType {
  NEW
  NEAR_REVIEW
  FAR_REVIEW
}

enum MemorizationSessionStatus {
  DRAFT
  COMPLETED
  VOID
}

enum SessionRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  WEAK
}

enum SessionPaymentStatus {
  NOT_APPLICABLE
  PENDING
  PAID
  WAIVED
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile   Profile?
  auditLogs AuditLog[] @relation("ActorAuditLogs")
  memorizationSessionsLed MemorizationSession[] @relation("MemorizationSessionTeacher")
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?
  parent    Parent?
}

model Parent {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  students StudentParent[]
}

model Student {
  id          String        @id @default(cuid())
  profileId   String        @unique
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fullName    String
  age         Int?
  phone       String?
  parentPhone String?
  address     String?

  joinedAt DateTime      @default(now())
  level    String?
  status   StudentStatus @default(REGULAR)

  parents       StudentParent[]
  schedules     StudentSchedule[]
  attendances   Attendance[]
  memorizations MemorizationRecord[]
  memorizationZones   StudentMemorizationZone[]
  memorizationSessions MemorizationSession[]
  memorizationSessionDrafts MemorizationSessionDraft[]
  memorizationStats    StudentMemorizationStats?
  invoices      Invoice[]
  payments      Payment[]
  subscriptions StudentSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fullName])
}

/** باقة اشتراك شهرية أو دورية (سعر مرجعي للمتابعة المالية). */
model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  /** سعر شهري مرجعي بالريال (أو العملة الافتراضية). */
  priceMonthly Decimal @db.Decimal(12, 2)
  currency    String   @default("SAR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions StudentSubscription[]
}

/** اشتراك طالب مرتبط بباقة — حالة وتواريخ. */
model StudentSubscription {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(ACTIVE)
  /** بداية الاشتراك (يوم فقط). */
  startedAt DateTime @db.Date
  /** نهاية مخططة إن وُجدت. */
  endsAt    DateTime? @db.Date
  cancelledAt DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([planId, status])
}

model StudentParent {
  studentId String
  parentId  String
  relation  String?
  isPrimary Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
}

model StudentSchedule {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  weekday   Weekday
  startTime String
  endTime   String
  notes     String?

  @@index([studentId, weekday])
}

model Attendance {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date   DateTime          @db.Date
  status AttendanceStatus
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([date])

  memorizationSessions MemorizationSession[]
}

model MemorizationRecord {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type        MemorizationType
  sessionDate DateTime         @db.Date

  fromSurah String?
  fromAyah  Int?
  toSurah   String?
  toAyah    Int?

  score Int?
  notes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, sessionDate])
}

/** حدود منطقة حفظ حالية لكل طالب (صف واحد لكل منطقة). */
model StudentMemorizationZone {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  zone MemorizationZoneType

  startSurah       Int?
  startAyah        Int?
  endSurah         Int?
  endAyah          Int?
  startGlobalIndex Int?
  endGlobalIndex   Int?
  /** للماضي البعيد: قائمة نطاقات إضافية [{startGlobalIndex,endGlobalIndex,startSurah,...}] */
  farRanges        Json?

  updatedAt DateTime @updatedAt

  @@unique([studentId, zone])
  @@index([studentId])
}

/** حصة تسميع — مصدر حقيقة للتقارير والمتابعة. */
model MemorizationSession {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sessionDate DateTime @db.Date
  status      MemorizationSessionStatus @default(DRAFT)

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  newSnapshot  Json?
  /** حدود منطقة NEAR قبل الحصة (مرجعية). */
  nearSnapshot Json?
  /** حدود منطقة FAR قبل الحصة (مرجعية). */
  farSnapshot Json?
  /** ما تمت مراجعته فعليًا من الماضي القريب في هذه الحصة (اختياري). */
  nearWorkSnapshot Json?
  /** ما تمت مراجعته فعليًا من الماضي البعيد في هذه الحصة (اختياري). */
  farWorkSnapshot Json?

  rating         SessionRating?
  paymentStatus  SessionPaymentStatus @default(NOT_APPLICABLE)
  paymentId      String?
  payment        Payment? @relation("MemorizationSessionPayment", fields: [paymentId], references: [id], onDelete: SetNull)

  notes          String?
  homeworkNext   String?
  durationMinutes Int?

  /** إن true: يُطبَّق نقل المعارج→قريب→بعيد بعد اكتمال سورة في الجديد (سياسة MVP). */
  autoPromoteCompletedSurah Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("MemorizationSessionTeacher", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, sessionDate])
  @@index([studentId, status])
}

/** مسودة نموذج حصة (واجهة) — مزامنة مع الخادم بجانب localStorage */
model MemorizationSessionDraft {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionDate DateTime @db.Date
  /** حقول JSON: واجب، ملاحظات، أرقام سور/آيات، إلخ */
  payload     Json

  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionDate])
  @@index([studentId])
}

/** مجاميع سريعة للوحة الطالب — تُحدَّث مع كل حصة مكتملة. */
model StudentMemorizationStats {
  id        String @id @default(cuid())
  studentId String @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sessionsCount     Int @default(0)
  absencesCount     Int @default(0)
  lastSessionAt     DateTime?
  lastRating        SessionRating?
  completionPercent Int           @default(0)
  progressLevel     String?

  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title    String
  amount   Decimal        @db.Decimal(12, 2)
  dueDate  DateTime?
  status   InvoiceStatus  @default(DRAFT)
  issuedAt DateTime       @default(now())

  payments Payment[]

  @@index([studentId, status])
}

model Payment {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @default(now())
  method      String?
  reference   String?
  note        String?
  recordedById String?

  memorizationSessions MemorizationSession[] @relation("MemorizationSessionPayment")

  @@index([studentId, paidAt])
}

model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model AcademySettings {
  id                   String   @id @default(cuid())
  academyName          String     @default("أكاديمية التحفيظ")
  defaultTeacherUserId String?
  timezone             String     @default("Asia/Riyadh")
  updatedAt            DateTime   @updatedAt
}
