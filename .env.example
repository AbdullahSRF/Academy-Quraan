# PostgreSQL — إنتاج: Neon pooled URL + ?sslmode=require (راجع docs/DEPLOYMENT.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quran_academy?schema=public"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public app URL (used by Auth.js) — لازم يطابق المنفذ (مثلاً 3000 أو إذا استخدمت -p 3001)
NEXTAUTH_URL="http://localhost:3000"

# نفس الأصل للميتاداتا / روابط مطلقة (Vercel: https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# إذا لم يفتح الموقع بعد التحديث أو ظهرت صفحة بيضاء: عطّل الـ PWA ثم أعد البناء
# NEXT_DISABLE_PWA=1

# أول مشرف: يُنشأ/يُحدَّث عند تشغيل `npm run db:seed` (لا تضع كلمات حقيقية هنا؛ انسخ إلى `.env` فقط)
ADMIN_EMAIL="admin@academy.local"
ADMIN_PASSWORD="change-me-strong-password"
