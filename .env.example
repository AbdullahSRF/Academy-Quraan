# PostgreSQL — إنتاج (Neon): انسخ connection string المجمّع من لوحة Neon وأضف ?sslmode=require إن لم يكن مضمّنًا
# مثال شكل: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — أنشئ مفتاحًا عشوائيًا: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# عنوان التطبيق العام (بدون شرطة مائلة في النهاية) — يجب أن يطابق نطاقك على Vercel أو النطاق المخصص
NEXTAUTH_URL="https://your-project.vercel.app"

# اختياري: إن وُجد يُفضّل للميتاداتا وروابط OG؛ وإلا يُشتق من NEXTAUTH_URL أو VERCEL_URL عند النشر
# NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# PWA: على Vercel يكون معطّلًا افتراضيًا. للتفعيل بعد النشر:
# NEXT_ENABLE_PWA=1
# NEXT_PUBLIC_ENABLE_PWA=1
# أو عطّل محليًا: NEXT_DISABLE_PWA=1

# أول مشرف: يُنشأ/يُحدَّث عند تشغيل `npm run db:seed` (لا تضع كلمات حقيقية هنا؛ انسخ إلى `.env` فقط)
ADMIN_EMAIL="admin@academy.local"
ADMIN_PASSWORD="change-me-strong-password"

# للتطوير المحلي فقط: يمكن استخدام Postgres محلي أو Docker وضبط DATABASE_URL وNEXTAUTH_URL على منفذ dev
