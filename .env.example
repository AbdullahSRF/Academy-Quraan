# مثال شكل: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_fqDwR4tN6jGM@ep-orange-wave-ap2u12gt-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js — أنشئ مفتاحًا عشوائيًا: openssl rand -base64 32
AUTH_SECRET="JA+L3HFe0urcCW9UBdVY97IzYdlu1UDZyFfRolnCvu8="

# عنوان التطبيق العام (بدون شرطة مائلة في النهاية) — يجب أن يطابق نطاقك على Vercel أو النطاق المخصص
NEXTAUTH_URL="https://quraan-academy.vercel.app"

# اختياري: إن وُجد يُفضّل للميتاداتا وروابط OG؛ وإلا يُشتق من NEXTAUTH_URL أو VERCEL_URL عند النشر
# NEXT_PUBLIC_APP_URL="https://quraan-academy.vercel.app"

# PWA: على Vercel يكون معطّلًا افتراضيًا. للتفعيل بعد النشر:
# NEXT_ENABLE_PWA=1
# NEXT_PUBLIC_ENABLE_PWA=1
# أو عطّل محليًا: NEXT_DISABLE_PWA=1

# أول مشرف: يُنشأ/يُحدَّث تلقائيًا عند `npm run dev` / `npm run start` وأيضًا ضمن `npm run db:seed` (لا تضع كلمات حقيقية في المستودع؛ انسخ إلى `.env` فقط)
